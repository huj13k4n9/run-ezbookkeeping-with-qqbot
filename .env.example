# QQ 机器人运行参数（不要把 .env 提交到 git）
#
# 在 QQ 开放平台 -> 开发设置 中获取 AppID 与 AppSecret
QQ_BOT_APP_ID=你的AppID
QQ_BOT_CLIENT_SECRET=你的AppSecret

# 是否使用沙箱环境（1/0），默认 0 正式环境
QQ_BOT_SANDBOX=0

# 订阅的事件位图，默认 33554432（只订阅单聊/群聊事件，不含公域频道事件）
#   1<<25 = 33554432  GROUP_AND_C2C_EVENT
#       单聊：C2C_MESSAGE_CREATE / FRIEND_ADD / FRIEND_DEL / C2C_MSG_RECEIVE / C2C_MSG_REJECT
#       群聊：GROUP_AT_MESSAGE_CREATE 等（与单聊共用这一位，无法只订阅单聊）
#   1<<30 = 1073741824 PUBLIC_GUILD_MESSAGES（公域频道 @机器人，本项目不需要）
# 如需同时接收公域频道事件，改成 1107296256 (= 33554432|1073741824)
QQ_BOT_INTENTS=33554432

# 分片：不分片保持 0 / 1
QQ_BOT_SHARD_ID=0
QQ_BOT_SHARD_TOTAL=1

# 日志级别：DEBUG / INFO / WARNING
QQ_BOT_LOG_LEVEL=INFO

# ---------------- 引用索引（ref-index）----------------
# 收到消息就建档，收到「引用消息」时按 ref_msg_idx 回查原文与附件。
# 对标官方 Node SDK 的 JsonlRefIndexStore。
QQ_BOT_REF_INDEX_ENABLED=1
QQ_BOT_REF_INDEX_PATH=data/ref-index.jsonl
QQ_BOT_REF_INDEX_TTL_DAYS=7
QQ_BOT_REF_INDEX_MAX_ENTRIES=50000

# ---------------- 附件自动落盘 ----------------
# 附件的 url 带 rkey 签名参数、有时效，必须收到就落盘，
# 否则用户引用时再取就晚了（引用回查会拿不到图片本体）。
# 留空 = 不落盘（此时引用回查只能拿到已过期的 URL）。
QQ_BOT_AUTO_DOWNLOAD_DIR=data/media
QQ_BOT_AUTO_DOWNLOAD_KINDS=image,voice
QQ_BOT_AUTO_DOWNLOAD_MAX_MB=20

# ---------------- 会话（pi session，按用户分配 + 定期轮换）----------------
# day  = 每天零点后换新会话（默认，上下文最短、最便宜）
# week = 每周换一次（上下文更连贯但更长）
# none = 不轮换（不建议）
QQ_BOT_SESSION_ROTATION=day
QQ_BOT_SESSION_PREFIX=qq
QQ_BOT_TIMEZONE=Asia/Shanghai

# ---------------- 去重 ----------------
# QQ 会重复推送同一条消息；窗口内的重复 msg_id 会被丢弃（秒）
QQ_BOT_DEDUP_TTL=600

# ---------------- 回复策略 ----------------
# 金额 >= 该值时先向用户确认再入账；0 = 关闭确认
QQ_BOT_CONFIRM_AMOUNT_THRESHOLD=1000
# 回复硬截断字数（QQ 超长会报 40054007）
QQ_BOT_REPLY_MAX_CHARS=500
# openid 白名单，逗号分隔；留空 = 不限制
QQ_BOT_ALLOWED_OPENIDS=

# ---------------- pi agent ----------------
QQ_BOT_AGENT_ENABLED=1
QQ_BOT_AGENT_COMMAND=pi
# pi 的工作目录：AGENTS.md 从这里被发现，必须指向 agent
QQ_BOT_AGENT_CWD=agent
QQ_BOT_AGENT_TOOLS=bash,read
QQ_BOT_AGENT_TIMEOUT=120
# 多模态模型填这里（留空用 pi 默认模型），例如 google/gemini-2.5-pro
QQ_BOT_AGENT_MODEL=
# 同时跑几个 agent，防止 VPS 被打满
QQ_BOT_AGENT_MAX_CONCURRENCY=2
# 追加任意 pi CLI 参数，空格分隔，例如 --thinking high
QQ_BOT_AGENT_EXTRA_ARGS=
# agent 进程透传的环境变量（其余不透传，避免把 QQ secret 给 agent）
# 留空 = 用内置默认值（含 PATH/HOME/TZ/EBKTOOL_*，不要删掉 EBKTOOL_*）
QQ_BOT_AGENT_PASSTHROUGH_ENV=

# ---------------- 工具脚本 ----------------
# ebktools.sh 路径（会写进 prompt 的 [工具] 行）
# 相对路径按 **bot 的 cwd** 解析；部署时建议写绝对路径
QQ_BOT_EBKTOOLS_PATH=.agents/skills/ezbookkeeping/scripts/ebktools.sh

# ==================== Docker / agent 运行环境 ====================
# 下面这些是 ebktools.sh 与 pi agent 需要的（qqbot 自己不用）

# ezBookkeeping 地址。
#   - 跑在宿主机上：http://host.docker.internal:8080
#   - 跑在另一个容器：http://<容器名或服务名>:8080
#   - 跑在远端：https://你的域名
EBKTOOL_SERVER_BASEURL=http://host.docker.internal:8080

# ezBookkeeping 的 API Token（界面 → 设置 → 令牌 → 生成 API Token）
EBKTOOL_TOKEN=

# 模型凭证：按你用的 provider 填一个即可（pi 直接读这些环境变量）
# QQ_BOT_AGENT_MODEL 决定用哪个模型
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# 如果 agent / .agents 不在本仓库目录下，在这里指到实际位置
# （docker compose 用它做绑定挂载的源路径）
AGENT_DIR=./agent
AGENTS_SKILLS_DIR=./.agents
