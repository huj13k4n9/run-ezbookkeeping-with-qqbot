{
  "_comment": "用法：sh scripts/init_config.sh 会生成一个空配置，或者 cp 本文件成 models.json 再改。它按文件挂载到 /app/pi-config/models.json，改完 docker compose restart qqbot 即可。",
  "_docs": "https://pi.dev/docs 的 models.md「Configure a compatible endpoint」",

  "providers": {
    "my-proxy": {
      "baseUrl": "https://your-llm-proxy.example.com/v1",
      "api": "openai-completions",
      "apiKey": "$MY_PROXY_API_KEY",
      "models": [
        {
          "id": "gpt-4o",
          "name": "GPT-4o (via proxy)",
          "input": ["text", "image"],
          "reasoning": false,
          "contextWindow": 128000,
          "maxTokens": 16384
        }
      ]
    }
  }
}
